# Copy this file to .env and fill in real values before running `docker compose up`.
# docker-compose.yml reads these to configure the postgres/backend/frontend containers.

# --- Database ---
DB_NAME=staysmart
DB_USERNAME=staysmart
DB_PASSWORD=change-this-password

# --- JWT ---
# Must be at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-super-secret-key-in-prod-min-32-bytes-please

# --- CORS ---
# Origin(s) the backend should accept requests from (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI (OpenAI via LangChain4j) ---
# Leave blank to run without AI features enabled (they'll return a clear
# "AI not configured" error instead of crashing the app).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=prod
