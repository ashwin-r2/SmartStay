# Copy this file to .env and fill in real values before running `docker compose up`.
# docker-compose.yml reads these to configure the postgres/backend/frontend containers.

# --- Database ---
DB_NAME=staysmart
DB_USERNAME=staysmart
DB_PASSWORD=change-this-password

# --- JWT ---
# Must be at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-super-secret-key-in-prod-min-32-bytes-please

# --- CORS ---
# Origin(s) the backend should accept requests from (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI (LangChain4j) ---
# AI_PROVIDER selects which client backend/src/main/java/com/staysmart/config/AiConfig.java
# wires up: "openai" (default), "gemini", or "claude". Only the selected provider's key
# matters; leave all three blank to run without AI features enabled (they'll return a clear
# "AI not configured" error instead of crashing the app).
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Gemini via Google AI Studio (https://aistudio.google.com/apikey). Only used when
# AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash

# Claude via the Anthropic API (https://console.anthropic.com/settings/keys). Only used when
# AI_PROVIDER=claude.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=prod
